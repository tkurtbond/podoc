#!/bin/sh
# runimages PODOC OUTDIR
#
# Tests images: --extract-media, and the PDFs made for ms (Phase 21).
# Copies test/images to OUTDIR/<test>, runs PODOC in its doc
# directory, and compares the output, the warnings and the files made
# with test/images-expected/<test>.{out,err,files}.
#
# These tests run with a PATH that holds only the commands podoc's shell
# commands need besides the converters (mkdir, cp, head, grep), so the
# results do not depend on what is installed. Two tests use the usual
# PATH: "convert" converts with the converters found there, and is
# skipped without rsvg-convert and one of img2pdf and magick (or
# convert); "pdf-eps" makes a PDF with groff from an EPS image
# (decision 26), and is skipped without groff, gs and pdftotext;
# "mom-eps" writes mom with an EPS image (decision 27), and is skipped
# without gs and pdfinfo; "mom-pdf" makes a PDF with pdfmom (Phase
# 23.5), and is skipped without pdfmom of groff 1.23 or later, gs,
# pdfinfo and pdftotext.
# Prints an "ok   - " or "FAIL - " line for each, and exits 1 if any
# failed.

if [ $# -ne 2 ]; then
  echo "usage: runimages PODOC OUTDIR" >&2
  exit 2
fi
podoc=$1
outdir=$2
case $podoc in /*) ;; *) podoc=$(pwd)/$podoc ;; esac
expected=$(pwd)/test/images-expected
rm -rf "$outdir"
mkdir -p "$outdir/bin" || exit 2
case $outdir in /*) ;; *) outdir=$(pwd)/$outdir ;; esac
for c in mkdir cp head grep; do
  p=$(command -v $c) || { echo "runimages: no $c" >&2; exit 2; }
  ln -s "$p" "$outdir/bin/$c"
done

failed=0
total=0

# check NAME: compares OUTDIR/NAME's results with the expected ones
check() {
  total=$((total + 1))
  w=$outdir/$1
  (cd "$w/doc" && find . -type f ! -name doc.md ! -path './img/*' | sort) \
    > "$w/files"
  if diff -u "$expected/$1.out" "$w/out" > "$w/diff" &&
     diff -u "$expected/$1.err" "$w/err" >> "$w/diff" &&
     diff -u "$expected/$1.files" "$w/files" >> "$w/diff"; then
    echo "ok   - images $1"
  else
    echo "FAIL - images $1"
    cat "$w/diff"
    failed=$((failed + 1))
  fi
}

# run NAME PATH ARGS...: runs podoc ARGS in a fresh copy, with PATH
run() {
  name=$1; path=$2; shift 2
  w=$outdir/$name
  mkdir -p "$w" && cp -R test/images/. "$w/" || exit 2
  (cd "$w/doc" && PATH=$path "$podoc" doc.md "$@" > ../out 2> ../err)
  echo "status $?" >> "$w/out"
}

bin=$outdir/bin
run extract-json "$bin" -t json --extract-media=media
check extract-json
run extract-html "$bin" -t html --extract-media=media
check extract-html
run extract-ms "$bin" -t ms --extract-media=media
check extract-ms
run ms-stdout "$bin" -t ms
check ms-stdout
run ms-file "$bin" -t ms -o out/doc.ms
cat "$outdir/ms-file/doc/out/doc.ms" >> "$outdir/ms-file/out"
check ms-file

# Conversion, with the converters installed
have() { command -v "$1" > /dev/null 2>&1; }
if have rsvg-convert && { have img2pdf || have magick || have convert; }; then
  run convert "$PATH" -t ms -o out/doc.ms
  w=$outdir/convert
  grep '^\.PDFPIC' "$w/doc/out/doc.ms" >> "$w/out"
  for f in "$w"/doc/out/doc-media/*.pdf; do
    [ "$(head -c 5 "$f")" = "%PDF-" ] || echo "not a PDF: ${f##*/}" >> "$w/out"
  done
  check convert
else
  echo "skip - images convert: no rsvg-convert, or no img2pdf or magick"
fi

# EPS in PDF made with groff -Tpdf, converted with Ghostscript
# (decision 26): the text drawn in the EPS is found in the PDF
if have groff && have gs && have pdftotext; then
  name=pdf-eps; w=$outdir/$name
  mkdir -p "$w" && cp -R test/images/. "$w/" || exit 2
  (cd "$w/doc" && "$podoc" img/eps.md -t ms --pdf-engine=groff \
     -o img/out.pdf > ../out 2> ../err)
  echo "status $?" >> "$w/out"
  pdftotext "$w/doc/img/out.pdf" - 2>/dev/null | grep -c EPSMARK >> "$w/out"
  check $name
else
  echo "skip - images pdf-eps: no groff, gs or pdftotext"
fi

# mom (decision 27): EPS converted with Ghostscript, and the sizes
# .PDF_IMAGE needs read with pdfinfo; with groff 1.23 or later, the
# text drawn in the EPS is found in the PDF pdfmom makes
if have gs && have pdfinfo; then
  name=mom-eps; w=$outdir/$name
  mkdir -p "$w" && cp -R test/images/. "$w/" || exit 2
  (cd "$w/doc" && "$podoc" img/mom.md -t mom -o out.mom > ../out 2> ../err)
  echo "status $?" >> "$w/out"
  cat "$w/doc/out.mom" >> "$w/out"
  check $name
  v=$(groff -v 2>/dev/null | sed -n 's/^GNU groff version \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
  set -- $v
  if have pdfmom && have pdftotext && [ $# -eq 2 ] &&
     { [ "$1" -gt 1 ] || [ "$2" -ge 23 ]; }; then
    total=$((total + 1)); n=0
    (cd "$w/doc" &&
     { printf '.PRINTSTYLE TYPESET\n.START\n'; cat out.mom; } > pdf.mom &&
     pdfmom pdf.mom > pdf.pdf 2> pdf.err) &&
    n=$(pdftotext "$w/doc/pdf.pdf" - 2>/dev/null | grep -c EPSMARK)
    if [ "$n" = 1 ] && [ ! -s "$w/doc/pdf.err" ]; then
      echo "ok   - images mom-eps pdf"
    else
      echo "FAIL - images mom-eps pdf"; cat "$w/doc/pdf.err"
      failed=$((failed + 1))
    fi
  else
    echo "skip - images mom-eps pdf: no pdfmom of groff 1.23 or later, or no pdftotext"
  fi
else
  echo "skip - images mom-eps: no gs or pdfinfo"
fi

# PDF through pdfmom (Phase 23.5), with groff 1.23 or later: the
# contents first, two pages, an outline, the EPS's text, and no files
# left beside the document
v=$(groff -v 2>/dev/null | sed -n 's/^GNU groff version \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
set -- $v
if have pdfmom && have gs && have pdfinfo && have pdftotext && [ $# -eq 2 ] &&
   { [ "$1" -gt 1 ] || [ "$2" -ge 23 ]; }; then
  total=$((total + 1))
  name=mom-pdf; w=$outdir/$name; r=
  mkdir -p "$w" && cp -R test/images/. "$w/" || exit 2
  (cd "$w/doc" && find . -type f | sort) > "$w/before"
  (cd "$w/doc" && "$podoc" img/mompdf.md -s --toc --pdf-engine=pdfmom \
     -o out.pdf > ../out 2> ../err) || r="status $?"
  f=$w/doc/out.pdf
  [ -s "$w/err" ] && r="$r, warnings"
  pdftotext -f 1 -l 1 "$f" - 2>/dev/null | grep -q '^Contents' ||
    r="$r, no contents first"
  pdfinfo "$f" 2>/dev/null | grep -q '^Pages: *2$' || r="$r, not two pages"
  grep -aq '/Outlines' "$f" || r="$r, no outline"
  [ "$(pdftotext "$f" - 2>/dev/null | grep -c EPSMARK)" = 1 ] ||
    r="$r, no EPS"
  (cd "$w/doc" && find . -type f ! -name out.pdf | sort) |
    cmp -s - "$w/before" || r="$r, files left"
  if [ -z "$r" ]; then
    echo "ok   - images mom-pdf"
  else
    echo "FAIL - images mom-pdf:$r"; cat "$w/err"
    failed=$((failed + 1))
  fi
else
  echo "skip - images mom-pdf: no pdfmom of groff 1.23 or later, or no gs, pdfinfo or pdftotext"
fi

echo "$((total - failed)) of $total image tests passed"
[ $failed -eq 0 ]
