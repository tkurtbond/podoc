#!/usr/bin/env python3
# mkwidth: writes src/PdWidth.Mod, character widths as pandoc 3.10's
# doclayout 0.5.0.3 gives them, from doclayout's source and that of
# emojis 0.1.5:
#
#   tools/mkwidth DOCLAYOUT-DIR EMOJIS-DIR > src/PdWidth.Mod
#
# DOCLAYOUT-DIR is doclayout's unpacked source (src/Text/unicodeWidth.inc),
# EMOJIS-DIR that of emojis (src/Text/emojis.inc), whose baseEmojis give
# doclayout's emojiMap: the characters an emoji starts with, and whether
# a variation selector or a skin tone modifier may follow them.
# The shortcut ranges below are those of updateMatchStateNarrow in
# src/Text/DocLayout.hs, which win over the table where they differ.
import re, sys, bisect
names={'NUL':0,'DEL':127}
s=open(sys.argv[1] + '/src/Text/unicodeWidth.inc').read()
pairs=re.findall(r"\(\s*'(\\'|\\\\|[^']+)'\s*,\s*(\w+)\s*\)",s)
def ch(t):
    if t=="\\'": return 39
    if t=='\\\\': return 92
    if t.startswith('\\'):
        t=t[1:]; return int(t) if t.isdigit() else names[t]
    assert len(t)==1,t; return ord(t)
starts=[(ch(k),v) for k,v in pairs]
assert starts==sorted(starts)
ks=[k for k,_ in starts]
N,W,C,Z='Narrow','Wide','Combining','Control'
def table(c):
    i=bisect.bisect_right(ks,c)-1
    if i<0: return Z
    v=starts[i][1]
    return N if v=='Ambiguous' else v
def short(c):
    if c<=0x1F: return Z
    if c<=0x7E: return N
    if c<=0x9F: return Z
    if c==0xAD: return Z
    if c<=0x2FF: return N
    if c<=0x36F: return C
    if 0x3250<=c<=0xA4CF: return W if c<=0x4DBF else (N if c<=0x4DFF else W)
    if 0x600<=c<=0x6FF:
        for lim,v in [(0x605,Z),(0x60F,N),(0x61A,C)]:
            if c<=lim: return v
        if c==0x61B: return N
        if c<=0x61C: return Z
        if c<=0x64A: return N
        if c<=0x65F: return C
        if c==0x670: return C
        if c<=0x6D5: return N
        if c<=0x6DC: return C
        if c==0x6DD: return Z
        if c==0x6DE: return N
        if c<=0x6E4: return C
        if c<=0x6E6: return N
        if c==0x6E9: return N
        if c<=0x6ED: return C
        return N
    if 0x900<=c<=0x97F:
        if c<=0x902: return C
        if c<=0x939: return N
        if c in (0x93A,0x93C): return C
        if c<=0x940: return N
        if c<=0x948: return C
        if c==0x94D: return C
        if c<=0x950: return N
        if c<=0x957: return C
        if c in (0x962,0x963): return C
        return N
    if 0x980<=c<=0xA02:
        if c in (0x981,0x9BC): return C
        if c<=0x9C0: return N
        if c<=0x9C4: return C
        if c==0x9CD: return C
        if c<=0x9E1: return N
        if c<=0x9E3: return C
        if c<=0x9FD: return N
        return C
    if 0x370<=c<=0x58F:
        if c<=0x482: return N
        if c<=0x489: return C
        return N
    if 0x2E80<=c<=0x324F:
        if c<=0x3029: return W
        if c<=0x302D: return C
        if c==0x303F: return N
        if c<=0x3096: return W
        if c<=0x309A: return C
        if c<=0x3247: return W
        return N
    if 0xAC00<=c<=0xD7A3: return W
    if 0xC00<=c<=0xC80:
        if c in (0xC00,0xC04): return C
        if c<=0xC39: return N
        if c==0xC3D: return N
        if c<=0xC40: return C
        if c<=0xC44: return N
        if c<=0xC56: return C
        if c in (0xC62,0xC63): return C
        return N
    if 0xB80<=c<=0xBFF:
        if c<=0xB82: return C
        if c in (0xBC0,0xBCD): return C
        return N
    if 0xE00<=c<=0xE7F:
        if c==0xE31 or 0xE34<=c<=0xE3A or 0xE47<=c<=0xE4E: return C
        return N
    if c==0x200D: return Z   # ZWJ after a non-emoji
    if c==0xFE0F: return Z
    if 0xF900<=c<=0xFAFF or 0xFF01<=c<=0xFF60 or 0xFFE0<=c<=0xFFE6 or 0x20000<=c<=0x3FFFF: return W
    if 0x1F3FB<=c<=0x1F3FF: return W
    return None
out=[]; diff=0
for c in range(0x110000):
    t=table(c); sv=short(c)
    if sv is not None and sv!=t: diff+=1
    v=sv if sv is not None else t
    if not out or out[-1][1]!=v: out.append((c,v))
print('shortcut/table differences:',diff,'ranges:',len(out),file=sys.stderr)
# doclayout's emojiMap: for each base emoji, its first character, and
# whether the second is a variation selector (V) or a skin tone (S)
e=open(sys.argv[2] + '/src/Text/emojis.inc').read()
e=e[e.index('baseEmojis ='):e.index('zwjEmojis =')]
emap={}
def hstring(t):
    # a Haskell string literal's characters: decimal escapes, \& and
    # literal characters
    cs=[]; i=0
    while i<len(t):
        if t[i]=='\\':
            m=re.match(r'\\(\d+)',t[i:])
            if m: cs.append(int(m.group(1))); i+=len(m.group(0)); continue
            assert t[i+1]=='&',t; i+=2; continue
        cs.append(ord(t[i])); i+=1
    return cs
for t in re.findall(r'"((?:[^"\\]|\\.)*)"',e):
    cs=hstring(t)
    x,xs=cs[0],cs[1:]
    v=1 if xs and 0xFE0E<=xs[0]<=0xFE0F else 0
    k=2 if xs and 0x1F3FB<=xs[0]<=0x1F3FF else 0
    emap[x]=emap.get(x,0)|v|k
eruns=[]
for c in sorted(emap):
    if eruns and eruns[-1][1]==c-1 and eruns[-1][2]==emap[c]: eruns[-1][1]=c
    else: eruns.append([c,c,emap[c]])
print('emoji keys:',len(emap),'runs:',len(eruns),file=sys.stderr)
elines=[]; cur='  '
for lo,hi,f in eruns:
    item='E(%XH, %XH, %d); '%(lo,hi,f)
    if len(cur)+len(item)>72: elines.append(cur.rstrip()); cur='  '
    cur+=item
elines.append(cur.rstrip())
ebody='\n'.join(elines)
ebody=re.sub(r'E\(([A-F])',r'E(0\1',ebody)
ebody=re.sub(r', ([A-F])',r', 0\1',ebody)
code={'Control':'control','Narrow':'narrow','Wide':'wide','Combining':'combining'}
lines=[]; cur='  '
for c,v in out:
    item='R(%XH, %s); '%(c,code[v])
    if item[2].isalpha(): pass
    if len(cur)+len(item)>72: lines.append(cur.rstrip()); cur='  '
    cur+=item
lines.append(cur.rstrip())
body='\n'.join(lines)
body=re.sub(r'R\(([A-F])',r'R(0\1',body)

HEAD = '''(* PdWidth: the width of a character in columns, as pandoc's doclayout
   0.5.0.3 gives it (charWidth): 0 for control and combining characters,
   1 for a regular one, 2 for an East Asian wide one; ambiguous ones are
   1. The ranges are doclayout's unicodeWidth.inc (BSD-3-Clause,
   copyright John MacFarlane), with the shortcut ranges of its
   updateMatchStateNarrow, which pandoc uses, laid over them.

   The width of a string, as doclayout's realLength gives it, is
   counted by a State (Start, Add, Total), which joins emoji sequences
   as doclayout does: a variation selector U+FE0F or a skin tone
   modifier after an emoji that takes it, and a zero-width joiner
   U+200D and what follows it, make no more columns. The emoji are
   those of emojis 0.1.5's baseEmojis (BSD-3-Clause, copyright John
   MacFarlane), which give doclayout's emojiMap.

   Generated by tools/mkwidth from doclayout's and emojis' source; do
   not edit. *)'''
MID = '''
MODULE PdWidth;

IMPORT Utf8;

CONST
  control* = 0; narrow* = 1; wide* = 2; combining* = 3; (* classes *)
  ranges = %d;
  emojiRuns = %d;
  variation = 1; skinTone = 2; (* what an emoji takes, emojiMap's EmojiInfo *)
  zwj = 200DH; vs16 = 0FE0FH; skinFirst = 1F3FBH; skinLast = 1F3FFH;

TYPE
  (* doclayout's MatchState: the width of the text so far is
     tot + tentative; last is the last character *)
  State* = RECORD
    first: BOOLEAN;
    tot, tentative: LONGINT;
    last: Utf8.Rune
  END;

VAR
  start: ARRAY ranges OF LONGINT; (* the first character of each range *)
  class: ARRAY ranges OF SHORTINT;
  n: INTEGER;
  eLo, eHi: ARRAY emojiRuns OF LONGINT; (* runs of emoji start characters *)
  eTakes: ARRAY emojiRuns OF SHORTINT; (* variation, skinTone *)
  ne: INTEGER;

PROCEDURE R(c: LONGINT; k: SHORTINT);
BEGIN
  start[n] := c; class[n] := k; INC(n)
END R;

PROCEDURE E(lo, hi: LONGINT; takes: SHORTINT);
BEGIN
  eLo[ne] := lo; eHi[ne] := hi; eTakes[ne] := takes; INC(ne)
END E;

(* The class of r: control, narrow, wide or combining *)
PROCEDURE Class*(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF r < 0 THEN RETURN control END;
  IF r < 7FH THEN
    IF r < 20H THEN RETURN control ELSE RETURN narrow END
  END;
  lo := 0; hi := ranges - 1; (* the last range starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF start[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  RETURN class[lo]
END Class;

(* charWidth: the width of r, 0, 1 or 2 *)
PROCEDURE Width*(r: Utf8.Rune): INTEGER;
  VAR k: INTEGER;
BEGIN
  k := Class(r);
  IF k = narrow THEN RETURN 1 ELSIF k = wide THEN RETURN 2 ELSE RETURN 0 END
END Width;

(* emojiMap: -1 if an emoji does not start with r, else what it takes *)
PROCEDURE Emoji(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF (r < eLo[0]) OR (r > eHi[emojiRuns - 1]) THEN RETURN -1 END;
  lo := 0; hi := emojiRuns - 1; (* the last run starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF eLo[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  IF r <= eHi[lo] THEN RETURN eTakes[lo] ELSE RETURN -1 END
END Emoji;

(* Start s for a string: realLength's MatchState True 0 ' ' 0 *)
PROCEDURE Start*(VAR s: State);
BEGIN
  s.first := TRUE; s.tot := 0; s.tentative := 0; s.last := 20H
END Start;

(* Add r to s, as doclayout's updateMatchStateNarrow does *)
PROCEDURE Add*(VAR s: State; r: Utf8.Rune);
  VAR e, w: INTEGER;
BEGIN
  IF (r = zwj) OR (r = vs16) OR (r >= skinFirst) & (r <= skinLast) THEN
    e := Emoji(s.last)
  END;
  IF r = zwj THEN
    IF (e >= 0) OR (s.last = vs16) OR (s.last >= skinFirst) & (s.last <= skinLast) THEN
      DEC(s.tot, 2); s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 0
    END
  ELSIF r = vs16 THEN
    IF (e >= 0) & ODD(e) THEN s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 0
    END
  ELSIF (r >= skinFirst) & (r <= skinLast) THEN
    IF (e >= 0) & (e DIV skinTone MOD 2 = 1) THEN s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 2
    END
  ELSE
    w := Class(r);
    INC(s.tot, s.tentative);
    IF w = narrow THEN s.tentative := 1
    ELSIF w = wide THEN s.tentative := 2
    ELSIF (w = combining) & s.first THEN s.tentative := 1
    ELSE s.tentative := 0
    END
  END;
  s.first := FALSE; s.last := r
END Add;

(* The width of the string added to s, realLength *)
PROCEDURE Total*(VAR s: State): LONGINT;
BEGIN
  RETURN s.tot + s.tentative
END Total;

BEGIN
  n := 0; ne := 0;
'''
sys.stdout.write(HEAD + MID % (len(out), len(eruns)) + body + '\n' + ebody + '\nEND PdWidth.\n')
