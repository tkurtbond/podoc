#!/usr/bin/env python3
# mkwidth: writes src/PdWidth.Mod, character widths as pandoc 3.10's
# doclayout 0.5.0.3 gives them, from doclayout's source:
#
#   tools/mkwidth DOCLAYOUT-DIR > src/PdWidth.Mod
#
# DOCLAYOUT-DIR is doclayout's unpacked source (src/Text/unicodeWidth.inc).
# The shortcut ranges below are those of updateMatchStateNarrow in
# src/Text/DocLayout.hs, which win over the table where they differ.
import re, sys, bisect
names={'NUL':0,'DEL':127}
s=open(sys.argv[1] + '/src/Text/unicodeWidth.inc').read()
pairs=re.findall(r"\(\s*'(\\'|\\\\|[^']+)'\s*,\s*(\w+)\s*\)",s)
def ch(t):
    if t=="\\'": return 39
    if t=='\\\\': return 92
    if t.startswith('\\'):
        t=t[1:]; return int(t) if t.isdigit() else names[t]
    assert len(t)==1,t; return ord(t)
starts=[(ch(k),v) for k,v in pairs]
assert starts==sorted(starts)
ks=[k for k,_ in starts]
N,W,C,Z='Narrow','Wide','Combining','Control'
def table(c):
    i=bisect.bisect_right(ks,c)-1
    if i<0: return Z
    v=starts[i][1]
    return N if v=='Ambiguous' else v
def short(c):
    if c<=0x1F: return Z
    if c<=0x7E: return N
    if c<=0x9F: return Z
    if c==0xAD: return Z
    if c<=0x2FF: return N
    if c<=0x36F: return C
    if 0x3250<=c<=0xA4CF: return W if c<=0x4DBF else (N if c<=0x4DFF else W)
    if 0x600<=c<=0x6FF:
        for lim,v in [(0x605,Z),(0x60F,N),(0x61A,C)]:
            if c<=lim: return v
        if c==0x61B: return N
        if c<=0x61C: return Z
        if c<=0x64A: return N
        if c<=0x65F: return C
        if c==0x670: return C
        if c<=0x6D5: return N
        if c<=0x6DC: return C
        if c==0x6DD: return Z
        if c==0x6DE: return N
        if c<=0x6E4: return C
        if c<=0x6E6: return N
        if c==0x6E9: return N
        if c<=0x6ED: return C
        return N
    if 0x900<=c<=0x97F:
        if c<=0x902: return C
        if c<=0x939: return N
        if c in (0x93A,0x93C): return C
        if c<=0x940: return N
        if c<=0x948: return C
        if c==0x94D: return C
        if c<=0x950: return N
        if c<=0x957: return C
        if c in (0x962,0x963): return C
        return N
    if 0x980<=c<=0xA02:
        if c in (0x981,0x9BC): return C
        if c<=0x9C0: return N
        if c<=0x9C4: return C
        if c==0x9CD: return C
        if c<=0x9E1: return N
        if c<=0x9E3: return C
        if c<=0x9FD: return N
        return C
    if 0x370<=c<=0x58F:
        if c<=0x482: return N
        if c<=0x489: return C
        return N
    if 0x2E80<=c<=0x324F:
        if c<=0x3029: return W
        if c<=0x302D: return C
        if c==0x303F: return N
        if c<=0x3096: return W
        if c<=0x309A: return C
        if c<=0x3247: return W
        return N
    if 0xAC00<=c<=0xD7A3: return W
    if 0xC00<=c<=0xC80:
        if c in (0xC00,0xC04): return C
        if c<=0xC39: return N
        if c==0xC3D: return N
        if c<=0xC40: return C
        if c<=0xC44: return N
        if c<=0xC56: return C
        if c in (0xC62,0xC63): return C
        return N
    if 0xB80<=c<=0xBFF:
        if c<=0xB82: return C
        if c in (0xBC0,0xBCD): return C
        return N
    if 0xE00<=c<=0xE7F:
        if c==0xE31 or 0xE34<=c<=0xE3A or 0xE47<=c<=0xE4E: return C
        return N
    if c==0x200D: return Z   # ZWJ after a non-emoji
    if c==0xFE0F: return Z
    if 0xF900<=c<=0xFAFF or 0xFF01<=c<=0xFF60 or 0xFFE0<=c<=0xFFE6 or 0x20000<=c<=0x3FFFF: return W
    if 0x1F3FB<=c<=0x1F3FF: return W
    return None
out=[]; diff=0
for c in range(0x110000):
    t=table(c); sv=short(c)
    if sv is not None and sv!=t: diff+=1
    v=sv if sv is not None else t
    if not out or out[-1][1]!=v: out.append((c,v))
print('shortcut/table differences:',diff,'ranges:',len(out),file=sys.stderr)
code={'Control':'control','Narrow':'narrow','Wide':'wide','Combining':'combining'}
lines=[]; cur='  '
for c,v in out:
    item='R(%XH, %s); '%(c,code[v])
    if item[2].isalpha(): pass
    if len(cur)+len(item)>72: lines.append(cur.rstrip()); cur='  '
    cur+=item
lines.append(cur.rstrip())
body='\n'.join(lines)
body=re.sub(r'R\(([A-F])',r'R(0\1',body)

HEAD = '''(* PdWidth: the width of a character in columns, as pandoc's doclayout
   0.5.0.3 gives it (charWidth): 0 for control and combining characters,
   1 for a regular one, 2 for an East Asian wide one; ambiguous ones are
   1. The ranges are doclayout's unicodeWidth.inc (BSD-3-Clause,
   copyright John MacFarlane), with the shortcut ranges of its
   updateMatchStateNarrow, which pandoc uses, laid over them. Emoji
   sequences (the zero-width joiner, variation selectors and skin tone
   modifiers after an emoji) are not combined; see PLAN.md's Later.
   Generated by tools/mkwidth from doclayout's source; do not edit. *)'''
MID = '''
MODULE PdWidth;

IMPORT Utf8;

CONST
  control* = 0; narrow* = 1; wide* = 2; combining* = 3; (* classes *)
  ranges = %d;

VAR
  start: ARRAY ranges OF LONGINT; (* the first character of each range *)
  class: ARRAY ranges OF SHORTINT;
  n: INTEGER;

PROCEDURE R(c: LONGINT; k: SHORTINT);
BEGIN
  start[n] := c; class[n] := k; INC(n)
END R;

(* The class of r: control, narrow, wide or combining *)
PROCEDURE Class*(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF r < 0 THEN RETURN control END;
  IF r < 7FH THEN
    IF r < 20H THEN RETURN control ELSE RETURN narrow END
  END;
  lo := 0; hi := ranges - 1; (* the last range starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF start[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  RETURN class[lo]
END Class;

(* charWidth: the width of r, 0, 1 or 2 *)
PROCEDURE Width*(r: Utf8.Rune): INTEGER;
  VAR k: INTEGER;
BEGIN
  k := Class(r);
  IF k = narrow THEN RETURN 1 ELSIF k = wide THEN RETURN 2 ELSE RETURN 0 END
END Width;

BEGIN
  n := 0;
'''
sys.stdout.write(HEAD + MID % len(out) + body + '\nEND PdWidth.\n')
