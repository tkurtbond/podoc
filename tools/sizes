#!/usr/bin/env python3
# sizes: compares the size of podoc's source with that of the pandoc
# source implementing the same features (docs/developer/size-comparisons.md):
#
#   tools/sizes
#
# It writes markdown tables to standard output: each group of podoc
# modules beside its pandoc counterpart, in lines and in code (lines
# neither blank nor comment), then whole-project totals. Haskell, Lua,
# Python and C are counted with tokei; Oberon here, by stripping nested
# (* *) comments.
#
# Where to find things, from the environment:
#   PANDOC_SRC        pandoc 3.10's source
#                     (/usr/local/sw/src/lang/Haskell/pandoc/pandoc-3.10)
#   DOCTEMPLATES_SRC  doctemplates' source
#                     (/usr/local/sw/src/lang/Haskell/pandoc/doctemplates)
#   CABAL_PACKAGES    cabal's package tarballs
#                     (~/.cabal/packages/hackage.haskell.org)
#   TMPDIR            where the tarballs are unpacked, in a directory
#                     removed afterwards (/usr/local/sw/tmp if it exists)
# The packages are the versions pandoc 3.10 builds against (PACKAGES).
# The user's Lua filters and pandoc-include are read only; where they
# are missing, that group's pandoc side is left out and said so.
import json, os, shutil, subprocess, sys, tarfile, tempfile

HOME = os.path.expanduser("~")
PD = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PANDOC = os.environ.get("PANDOC_SRC",
    "/usr/local/sw/src/lang/Haskell/pandoc/pandoc-3.10")
HS = PANDOC + "/src/Text/Pandoc"
DT = os.environ.get("DOCTEMPLATES_SRC",
    "/usr/local/sw/src/lang/Haskell/pandoc/doctemplates") + "/src"
CABAL = os.environ.get("CABAL_PACKAGES",
    HOME + "/.cabal/packages/hackage.haskell.org")
PACKAGES = {"pandoc-types": "1.23.1", "doclayout": "0.5",
            "yaml": "0.11.11.2", "libyaml": "0.1.4",
            "texmath": "0.13.1.2", "commonmark": "0.3"}
FILTERS = [HOME + "/.local/lib/python3.14/site-packages/pandoc_include/main.py",
           HOME + "/.pandoc/filters/general.lua",
           HOME + "/.pandoc/filters/strip-comments.lua",
           HOME + "/Repos/RPG/Lost-Worlds/subs.lua",
           HOME + "/Repos/RPG/Lost-Worlds/toc-columns.lua",
           HOME + "/Repos/RPG/Lost-Worlds/combine-docs.lua"]

def oberon(path):
    """(lines, code) of an Oberon file: comments nest; strings hide them."""
    s = open(path, encoding="utf-8", errors="replace").read()
    out = []; i = 0; depth = 0; n = len(s)
    while i < n:
        c = s[i]
        if depth == 0 and c in "\"'":
            j = s.find(c, i + 1)
            if j < 0 or "\n" in s[i:j]: j = i
            out.append(s[i:j + 1]); i = j + 1; continue
        if s.startswith("(*", i): depth += 1; i += 2; continue
        if depth and s.startswith("*)", i): depth -= 1; i += 2; continue
        if depth:
            if c == "\n": out.append("\n")
            i += 1; continue
        out.append(c); i += 1
    code = sum(1 for l in "".join(out).split("\n") if l.strip())
    return s.count("\n"), code

def tokei(paths, lang=None):
    """(lines, code) of paths, by tokei."""
    cmd = ["tokei", "-o", "json"] + (["-t", lang] if lang else []) + paths
    t = json.loads(subprocess.run(cmd, capture_output=True, text=True,
                                  check=True).stdout)["Total"]
    return t["code"] + t["comments"] + t["blanks"], t["code"]

def count(paths):
    for p in paths:
        if not os.path.exists(p): sys.exit("sizes: missing " + p)
    L = C = 0
    for p in paths:
        if p.endswith(".Mod"):
            l, c = oberon(p); L += l; C += c
    other = [p for p in paths if not p.endswith(".Mod")]
    if other:
        l, c = tokei(other); L += l; C += c
    return L, C

def pd(*names): return [f"{PD}/src/{n}.Mod" for n in names]
def hs(*names): return [f"{HS}/{n}.hs" for n in names]

def main(tmp):
    pkg = {}
    for p, v in PACKAGES.items():
        tar = f"{CABAL}/{p}/{v}/{p}-{v}.tar.gz"
        if not os.path.exists(tar): sys.exit("sizes: missing " + tar)
        with tarfile.open(tar) as t: t.extractall(tmp, filter="data")
        pkg[p] = f"{tmp}/{p}-{v}/src"
    def hsdir(d):
        return sorted(os.path.join(r, f) for r, _, fs in os.walk(d)
                      for f in fs if f.endswith(".hs"))

    parsing = hs("Parsing", *("Parsing/" + x for x in
        "Capabilities Citations Future General GridTable Lists Math Smart State".split()))
    filters = [f for f in FILTERS if os.path.exists(f)]
    groups = [
     ("Markdown reader",
      pd("PdMarkdown", "PdMdBase", "PdMdInline", "PdGridTable", "PdSource"),
      hs("Readers/Markdown", "Sources", "App/Input", "Asciify") + parsing),
     ("YAML metadata", pd("PdYaml"),
      hs("Readers/Metadata") + hsdir(pkg["yaml"]) + hsdir(pkg["libyaml"])),
     ("AST and JSON", pd("PdAst", "PdJson"), hsdir(pkg["pandoc-types"])),
     ("Templates", pd("PdTemplate", "PdContext"),
      hs("Templates") + hsdir(DT)),
     ("Layout and wrapping", pd("PdLayout", "PdWidth"),
      hsdir(pkg["doclayout"])),
     ("Shared writer code", pd("PdShared"), hs("Shared", "Writers/Shared")),
     ("HTML writer", pd("PdHtml"), hs("Writers/HTML")),
     ("ms writer", pd("PdMs", "PdRoff"), hs("Writers/Ms", "Writers/Roff", "RoffChar")),
     ("mom writer", pd("PdMom"), []),
     ("ConTeXt writer", pd("PdConTeXt"), hs("Writers/ConTeXt")),
     ("Markdown and plain writers", pd("PdMdWriter"),
      hs("Writers/Markdown", "Writers/Markdown/Inline", "Writers/Markdown/Table",
         "Writers/Markdown/Types", "Writers/GridTable")),
     ("Command line and driver", pd("podoc", "PdOptions", "PdIO"),
      hs("App", "App/CommandLineOptions", "App/Opt", "App/OutputSettings",
         "Options", "Extensions", "Error")),
     ("PDF", pd("PdPdf", "PdRun"), hs("PDF", "Process")),
     ("Includes and filters",
      pd("PdInclude", "PdGlob", "PdFilters") + [PD + "/src/PdGlob.c"], filters),
    ]
    generated = ("Generated tables",
      pd("PdEntities", "PdAscii", "PdMime", "PdWords", "PdDefaults"), hs("MIME"))

    def row(name, a, b, bold=False):
        (pl, pc), (hl, hc) = count(a), (count(b) if b else (0, 0))
        r = f"{pc / hc:.2f}" if hc else "—"
        f = (lambda x: f"**{x}**") if bold else str
        print(f"| {f(name)} | {f(f'{pl:,} / {pc:,}')} | {f(f'{hl:,} / {hc:,}')} | {f(r)} |")
        return pl, pc, hl, hc

    print("| Feature | podoc lines / code | pandoc lines / code | podoc ÷ pandoc (code) |")
    print("|---|---:|---:|---:|")
    tot = [0] * 4
    for g in groups:
        tot = [x + y for x, y in zip(tot, row(*g))]
    print(f"| **Total, hand-written** | **{tot[0]:,} / {tot[1]:,}** "
          f"| **{tot[2]:,} / {tot[3]:,}** | **{tot[1] / tot[3]:.2f}** |")
    row(*generated)
    for f in FILTERS:
        if f not in filters:
            print(f"\nNot found, left out of the filters' pandoc side: {f}")

    print("\n| Whole project | Lines | Code |\n|---|---:|---:|")
    def whole(name, paths, lang=None):
        l, c = tokei(paths, lang)
        print(f"| {name} | {l:,} | {c:,} |")
    whole("pandoc's own Haskell (`src/`)", [PANDOC + "/src"], "Haskell")
    whole("pandoc-lua-engine", [PANDOC + "/pandoc-lua-engine/src"], "Haskell")
    whole("texmath", [pkg["texmath"]], "Haskell")
    whole("pandoc, pandoc-lua-engine, pandoc-types, doclayout, doctemplates, "
          "texmath, commonmark",
          [PANDOC + "/src", PANDOC + "/pandoc-lua-engine/src", pkg["pandoc-types"],
           pkg["doclayout"], DT, pkg["texmath"], pkg["commonmark"]], "Haskell")
    mods = sorted(f"{PD}/src/{f}" for f in os.listdir(PD + "/src")
                  if f.endswith(".Mod"))
    l, c = count(mods + [PD + "/src/PdGlob.c"])
    print(f"| podoc: all `src/` | {l:,} | {c:,} |")
    tests = subprocess.run(["git", "-C", PD, "ls-files", "test"],
        capture_output=True, text=True, check=True).stdout.split()
    n = sum(open(f"{PD}/{t}", "rb").read().count(b"\n") for t in tests)
    print(f"| podoc: tests (all lines) | {n:,} | |")

if shutil.which("tokei") is None:
    sys.exit("sizes: tokei not found")
base = os.environ.get("TMPDIR") or (
    "/usr/local/sw/tmp" if os.path.isdir("/usr/local/sw/tmp") else None)
tmp = tempfile.mkdtemp(prefix="podoc-sizes-", dir=base)
try:
    main(tmp)
finally:
    shutil.rmtree(tmp)
