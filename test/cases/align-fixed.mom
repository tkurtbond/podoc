#define WWWWWWWWWWWW\h'(22u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'64\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* deliberately wide */\*[ROM]
#define DEPTH\h'(18u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'8\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* nesting */\*[ROM]

\*[BD]struct\*[ROM] entry {
\h'|4u*\n[PdCodeCol]u'\*[BD]int\*[ROM]\h'(12u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'kind;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* what it is */\*[ROM]
\h'|4u*\n[PdCodeCol]u'\*[BD]char\*[ROM]\h'(11u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'*name;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* its name */\*[ROM]
\h'|4u*\n[PdCodeCol]u'\*[BD]long\*[ROM]\h'(12u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'value;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* its value */\*[ROM]
};

\*[BD]int\*[ROM] classify(\*[BD]struct\*[ROM] entry *e)
{
\h'|4u*\n[PdCodeCol]u'\*[BD]switch\*[ROM] (e->kind) {
\h'|4u*\n[PdCodeCol]u'\*[BD]case\*[ROM] 0:\h'(13u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[BD]return\*[ROM] \(aqa\(aq;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* plain */\*[ROM]
\h'|4u*\n[PdCodeCol]u'\*[BD]case\*[ROM] 1:\h'(13u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[BD]return\*[ROM] \(aq\(dq\(aq;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* quoted */\*[ROM]
\h'|4u*\n[PdCodeCol]u'\*[BD]default\*[ROM]: \*[BD]return\*[ROM] -1;\h'(28u*\n[PdCodeCol]u-\n[.k]u)>?\n[PdCodeGap]u'\*[IT]/* none -- unknown */\*[ROM]
\h'|4u*\n[PdCodeCol]u'}
