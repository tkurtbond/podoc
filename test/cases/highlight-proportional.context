\startsectionlevel[title={Head
\type[escape=yes]{/BTEX\bf IF/ETEX x /BTEX{\it (*~c~*)}/ETEX /BTEX\bf END/ETEX}},reference={head-if-x-c-end}]

Inline
\type[escape=yes]{/BTEX\bf IF/ETEX x /BTEX\bf THEN/ETEX /BTEX{\it (*~c~*)}/ETEX /BTEX\bf END/ETEX},
\type[escape=yes]{/BTEX\bf int/ETEX x; /BTEX{\it //~c~\{\}}/ETEX},
\type{IF x} and \type{plain}.

\ifdefined\PdSeg\else
\definefontfeature[pdcode][default][textcontrol=no]
\definefont[PdCodeR][Serif*pdcode]
\definefont[PdCodeB][SerifBold*pdcode]
\definefont[PdCodeI][SerifItalic*pdcode]
\ifdefined\PdColumn\else\newdimen\PdColumn \PdColumn=0.5em\fi
\ifdefined\PdGap\else\def\PdGap{1em}\fi
\newdimen\PdPos \newdimen\PdT \newbox\PdBox
\def\PdLine{\global\PdPos=0pt\relax}
\def\PdSeg#1#2{\setbox\PdBox\hbox{#2}\PdT=#1\relax
  \ifdim\PdPos>0pt \ifdim\PdT<\dimexpr\PdPos+\PdGap\relax \PdT=\dimexpr\PdPos+\PdGap\relax\fi\fi
  \hskip\dimexpr\PdT-\PdPos\relax \global\PdPos=\dimexpr\PdT+\wd\PdBox\relax \box\PdBox}
\def\PdMeasure#1#2{\setbox\PdBox\hbox{#2}%
  \ifdim\dimexpr\wd\PdBox+\PdGap\relax>\getvalue{#1}\relax
    \setxvalue{#1}{\the\dimexpr\wd\PdBox+\PdGap\relax}\fi}
\fi
\startlines[style=\PdCodeR]
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}MODULE}~M;~{\PdCodeI{}(*~a~\{comment\}}}
\PdLine\PdSeg{2\PdColumn}{{\PdCodeI{}over~two~lines~*)}}
\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}VAR}~s:~{\PdCodeB{}ARRAY}~8~{\PdCodeB{}OF}~CHAR;~{\PdCodeI{}(*~it's~-\kern0pt-~50\letterpercent{}~*)}}
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}BEGIN}~s~:=~"(*~a\letterbackslash{}b~*)";~t~:=~'END'}
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}END}~M.}
\stoplines

\startlines[style=\PdCodeR]
\PdLine\PdSeg{0\PdColumn}{.dot~at~start}
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}static}~{\PdCodeB{}int}~f({\PdCodeB{}void})~\{~{\PdCodeB{}return}~'\letterbackslash{}'\kern0pt';~\}~{\PdCodeI{}//~x-\kern0pt-y~`\kern0pt`z'\kern0pt'}}
\stoplines

\startlines[style=\PdCodeR]
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}FROM}~InOut~{\PdCodeB{}IMPORT}~WriteString;~{\PdCodeI{}(*~end~END~*)}}
\stoplines

\startlines[style=\PdCodeR]
\PdLine\PdSeg{0\PdColumn}{no~language~\#~\$~\{~\}~-\kern0pt-~x}
\stoplines

\starttyping
MODULE Plain;
\stoptyping

\stopsectionlevel
