An Oberon module:

\ifdefined\PdSeg\else
\definefontfeature[pdcode][default][textcontrol=no]
\definefont[PdCodeR][Serif*pdcode]
\definefont[PdCodeB][SerifBold*pdcode]
\definefont[PdCodeI][SerifItalic*pdcode]
\ifdefined\PdColumn\else\newdimen\PdColumn \PdColumn=0.5em\fi
\ifdefined\PdGap\else\def\PdGap{1em}\fi
\newdimen\PdPos \newdimen\PdT \newbox\PdBox
\def\PdLine{\global\PdPos=0pt\relax}
\def\PdSeg#1#2{\setbox\PdBox\hbox{#2}\PdT=#1\relax
  \ifdim\PdPos>0pt \ifdim\PdT<\dimexpr\PdPos+\PdGap\relax \PdT=\dimexpr\PdPos+\PdGap\relax\fi\fi
  \hskip\dimexpr\PdT-\PdPos\relax \global\PdPos=\dimexpr\PdT+\wd\PdBox\relax \box\PdBox}
\def\PdMeasure#1#2{\setbox\PdBox\hbox{#2}%
  \ifdim\dimexpr\wd\PdBox+\PdGap\relax>\getvalue{#1}\relax
    \setxvalue{#1}{\the\dimexpr\wd\PdBox+\PdGap\relax}\fi}
\fi
\setvalue{PdG1}{0pt}
\PdMeasure{PdG1}{\PdCodeR\PdLine\PdSeg{4\PdColumn}{Max~=~100;}}
\PdMeasure{PdG1}{\PdCodeR\PdLine\PdSeg{4\PdColumn}{Overflow~=~1;}}
\setvalue{PdG2}{0pt}
\PdMeasure{PdG2}{\PdCodeR\PdLine\PdSeg{4\PdColumn}{top:~INTEGER;}}
\setvalue{PdG3}{0pt}
\PdMeasure{PdG3}{\PdCodeR\PdLine\PdSeg{6\PdColumn}{HALT(Overflow)}}
\setvalue{PdG4}{0pt}
\PdMeasure{PdG4}{\PdCodeR\PdLine\PdSeg{4\PdColumn}{items{[}top{]}~:=~x;}}
\PdMeasure{PdG4}{\PdCodeR\PdLine\PdSeg{4\PdColumn}{INC(top)}}
\setvalue{PdG5}{0pt}
\PdMeasure{PdG5}{\PdCodeR\PdLine\PdSeg{2\PdColumn}{top~:=~0}}
\startlines[style=\PdCodeR]
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}MODULE}~Stack;}
\PdLine\PdSeg{2\PdColumn}{{\PdCodeI{}(*~A~bounded~stack~of~integers.~*)}}

\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}CONST}}
\PdLine\PdSeg{4\PdColumn}{Max~=~100;}\PdSeg{\getvalue{PdG1}}{{\PdCodeI{}(*~capacity~*)}}
\PdLine\PdSeg{4\PdColumn}{Overflow~=~1;}\PdSeg{\getvalue{PdG1}}{{\PdCodeI{}(*~HALT~code:~too~many~pushes~*)}}

\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}VAR}}
\PdLine\PdSeg{4\PdColumn}{top:~INTEGER;}\PdSeg{\getvalue{PdG2}}{{\PdCodeI{}(*~items~in~use~*)}}
\PdLine\PdSeg{4\PdColumn}{items:~{\PdCodeB{}ARRAY}~Max~{\PdCodeB{}OF}~INTEGER;}

\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}PROCEDURE}~Push*(x:~INTEGER);}
\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}BEGIN}}
\PdLine\PdSeg{4\PdColumn}{{\PdCodeB{}IF}~top~=~Max~{\PdCodeB{}THEN}}
\PdLine\PdSeg{6\PdColumn}{HALT(Overflow)}\PdSeg{\getvalue{PdG3}}{{\PdCodeI{}(*~it's~full~*)}}
\PdLine\PdSeg{4\PdColumn}{{\PdCodeB{}END};}
\PdLine\PdSeg{4\PdColumn}{items{[}top{]}~:=~x;}\PdSeg{\getvalue{PdG4}}{{\PdCodeI{}(*~store~it~*)}}
\PdLine\PdSeg{4\PdColumn}{INC(top)}\PdSeg{\getvalue{PdG4}}{{\PdCodeI{}(*~and~count~it~*)}}
\PdLine\PdSeg{2\PdColumn}{{\PdCodeB{}END}~Push;}

\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}BEGIN}}
\PdLine\PdSeg{2\PdColumn}{top~:=~0}\PdSeg{\getvalue{PdG5}}{{\PdCodeI{}(*~empty~at~first~*)}}
\PdLine\PdSeg{0\PdColumn}{{\PdCodeB{}END}~Stack.}
