(* PdWidth: the width of a character in columns, as pandoc's doclayout
   0.5.0.3 gives it (charWidth): 0 for control and combining characters,
   1 for a regular one, 2 for an East Asian wide one; ambiguous ones are
   1. The ranges are doclayout's unicodeWidth.inc (BSD-3-Clause,
   copyright John MacFarlane), with the shortcut ranges of its
   updateMatchStateNarrow, which pandoc uses, laid over them.

   The width of a string, as doclayout's realLength gives it, is
   counted by a State (Start, Add, Total), which joins emoji sequences
   as doclayout does: a variation selector U+FE0F or a skin tone
   modifier after an emoji that takes it, and a zero-width joiner
   U+200D and what follows it, make no more columns. The emoji are
   those of emojis 0.1.5's baseEmojis (BSD-3-Clause, copyright John
   MacFarlane), which give doclayout's emojiMap.

   Generated by tools/mkwidth from doclayout's and emojis' source; do
   not edit. *)
MODULE PdWidth;

IMPORT Utf8;

CONST
  control* = 0; narrow* = 1; wide* = 2; combining* = 3; (* classes *)
  ranges = 797;
  emojiRuns = 264;
  variation = 1; skinTone = 2; (* what an emoji takes, emojiMap's EmojiInfo *)
  zwj = 200DH; vs16 = 0FE0FH; skinFirst = 1F3FBH; skinLast = 1F3FFH;

TYPE
  (* doclayout's MatchState: the width of the text so far is
     tot + tentative; last is the last character *)
  State* = RECORD
    first: BOOLEAN;
    tot, tentative: LONGINT;
    last: Utf8.Rune
  END;

VAR
  start: ARRAY ranges OF LONGINT; (* the first character of each range *)
  class: ARRAY ranges OF SHORTINT;
  n: INTEGER;
  eLo, eHi: ARRAY emojiRuns OF LONGINT; (* runs of emoji start characters *)
  eTakes: ARRAY emojiRuns OF SHORTINT; (* variation, skinTone *)
  ne: INTEGER;

PROCEDURE R(c: LONGINT; k: SHORTINT);
BEGIN
  start[n] := c; class[n] := k; INC(n)
END R;

PROCEDURE E(lo, hi: LONGINT; takes: SHORTINT);
BEGIN
  eLo[ne] := lo; eHi[ne] := hi; eTakes[ne] := takes; INC(ne)
END E;

(* The class of r: control, narrow, wide or combining *)
PROCEDURE Class*(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF r < 0 THEN RETURN control END;
  IF r < 7FH THEN
    IF r < 20H THEN RETURN control ELSE RETURN narrow END
  END;
  lo := 0; hi := ranges - 1; (* the last range starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF start[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  RETURN class[lo]
END Class;

(* charWidth: the width of r, 0, 1 or 2 *)
PROCEDURE Width*(r: Utf8.Rune): INTEGER;
  VAR k: INTEGER;
BEGIN
  k := Class(r);
  IF k = narrow THEN RETURN 1 ELSIF k = wide THEN RETURN 2 ELSE RETURN 0 END
END Width;

(* emojiMap: -1 if an emoji does not start with r, else what it takes *)
PROCEDURE Emoji(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF (r < eLo[0]) OR (r > eHi[emojiRuns - 1]) THEN RETURN -1 END;
  lo := 0; hi := emojiRuns - 1; (* the last run starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF eLo[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  IF r <= eHi[lo] THEN RETURN eTakes[lo] ELSE RETURN -1 END
END Emoji;

(* Start s for a string: realLength's MatchState True 0 ' ' 0 *)
PROCEDURE Start*(VAR s: State);
BEGIN
  s.first := TRUE; s.tot := 0; s.tentative := 0; s.last := 20H
END Start;

(* Add r to s, as doclayout's updateMatchStateNarrow does *)
PROCEDURE Add*(VAR s: State; r: Utf8.Rune);
  VAR e, w: INTEGER;
BEGIN
  IF (r = zwj) OR (r = vs16) OR (r >= skinFirst) & (r <= skinLast) THEN
    e := Emoji(s.last)
  END;
  IF r = zwj THEN
    IF (e >= 0) OR (s.last = vs16) OR (s.last >= skinFirst) & (s.last <= skinLast) THEN
      DEC(s.tot, 2); s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 0
    END
  ELSIF r = vs16 THEN
    IF (e >= 0) & ODD(e) THEN s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 0
    END
  ELSIF (r >= skinFirst) & (r <= skinLast) THEN
    IF (e >= 0) & (e DIV skinTone MOD 2 = 1) THEN s.tentative := 2
    ELSE INC(s.tot, s.tentative); s.tentative := 2
    END
  ELSE
    w := Class(r);
    INC(s.tot, s.tentative);
    IF w = narrow THEN s.tentative := 1
    ELSIF w = wide THEN s.tentative := 2
    ELSIF (w = combining) & s.first THEN s.tentative := 1
    ELSE s.tentative := 0
    END
  END;
  s.first := FALSE; s.last := r
END Add;

(* The width of the string added to s, realLength *)
PROCEDURE Total*(VAR s: State): LONGINT;
BEGIN
  RETURN s.tot + s.tentative
END Total;

