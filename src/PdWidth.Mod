(* PdWidth: the width of a character in columns, as pandoc's doclayout
   0.5.0.3 gives it (charWidth): 0 for control and combining characters,
   1 for a regular one, 2 for an East Asian wide one; ambiguous ones are
   1. The ranges are doclayout's unicodeWidth.inc (BSD-3-Clause,
   copyright John MacFarlane), with the shortcut ranges of its
   updateMatchStateNarrow, which pandoc uses, laid over them. Emoji
   sequences (the zero-width joiner, variation selectors and skin tone
   modifiers after an emoji) are not combined; see PLAN.md's Later.
   Generated by tools/mkwidth from doclayout's source; do not edit. *)
MODULE PdWidth;

IMPORT Utf8;

CONST
  control* = 0; narrow* = 1; wide* = 2; combining* = 3; (* classes *)
  ranges = 797;

VAR
  start: ARRAY ranges OF LONGINT; (* the first character of each range *)
  class: ARRAY ranges OF SHORTINT;
  n: INTEGER;

PROCEDURE R(c: LONGINT; k: SHORTINT);
BEGIN
  start[n] := c; class[n] := k; INC(n)
END R;

(* The class of r: control, narrow, wide or combining *)
PROCEDURE Class*(r: Utf8.Rune): INTEGER;
  VAR lo, hi, m: INTEGER;
BEGIN
  IF r < 0 THEN RETURN control END;
  IF r < 7FH THEN
    IF r < 20H THEN RETURN control ELSE RETURN narrow END
  END;
  lo := 0; hi := ranges - 1; (* the last range starting at or before r *)
  WHILE lo < hi DO
    m := (lo + hi + 1) DIV 2;
    IF start[m] <= r THEN lo := m ELSE hi := m - 1 END
  END;
  RETURN class[lo]
END Class;

(* charWidth: the width of r, 0, 1 or 2 *)
PROCEDURE Width*(r: Utf8.Rune): INTEGER;
  VAR k: INTEGER;
BEGIN
  k := Class(r);
  IF k = narrow THEN RETURN 1 ELSIF k = wide THEN RETURN 2 ELSE RETURN 0 END
END Width;

BEGIN
